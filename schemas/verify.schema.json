{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet observed-version verification result v1",
  "description": "Per-host verification outcome. Schema validity does not authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collected_at", "target", "packages", "summary", "error"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "collected_at": {"$ref": "#/$defs/timestamp"},
    "target": {"$ref": "#/$defs/host_name"},
    "packages": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/package_name"},
      "additionalProperties": {"$ref": "#/$defs/package_result"}
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "passed", "failed", "error"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0}
      }
    },
    "error": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {"code": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"}}
        }
      ]
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "not": {"pattern": "\\s"}
    },
    "host_name": {
      "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "not": {"pattern": "\\s"}
    },
    "package_name": {
      "type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]+(:[a-z0-9][a-z0-9-]*)?$",
      "not": {"pattern": "\\s"}
    },
    "version": {"type": "string", "minLength": 1, "not": {"pattern": "\\s"}},
    "package_status": {"enum": ["pass", "fail", "error"]},
    "health_check_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["service", "check", "status", "detail"],
      "properties": {
        "service": {"$ref": "#/$defs/text"},
        "check": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "host": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "unit": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "url": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "status": {"enum": ["pass", "fail", "error", "skipped"]},
        "detail": {"$ref": "#/$defs/text"}
      }
    },
    "package_result": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "architecture", "status", "detail", "expected_version",
                   "observed_version", "version_check", "health_checks"],
      "properties": {
        "name": {"$ref": "#/$defs/package_name"},
        "architecture": {
          "anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}]
        },
        "status": {"$ref": "#/$defs/package_status"},
        "detail": {"$ref": "#/$defs/text"},
        "expected_version": {"$ref": "#/$defs/version"},
        "observed_version": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/version"}]},
        "version_check": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "architecture", "status", "detail", "data"],
          "properties": {
            "name": {"$ref": "#/$defs/package_name"},
            "architecture": {
              "anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}]
            },
            "status": {"$ref": "#/$defs/package_status"},
            "detail": {"$ref": "#/$defs/text"},
            "data": {"type": "object"}
          }
        },
        "health_checks": {
          "type": "array", "items": {"$ref": "#/$defs/health_check_entry"}
        }
      }
    }
  }
}
