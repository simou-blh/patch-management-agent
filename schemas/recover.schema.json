{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet recovery result v1",
  "description": "Per-host recovery outcome. Schema validity does not guarantee successful recovery.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collected_at", "target", "diagnostics", "repair",
               "restoration", "manual_intervention", "error"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "collected_at": {"$ref": "#/$defs/timestamp"},
    "target": {"$ref": "#/$defs/host_name"},
    "diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["dpkg_audit", "apt_policy", "service_status"],
      "properties": {
        "dpkg_audit": {"type": "object"},
        "apt_policy": {"type": "object"},
        "service_status": {"type": "object"}
      }
    },
    "repair": {
      "type": "object", "additionalProperties": false,
      "required": ["attempted", "command", "dry_run", "result", "detail"],
      "properties": {
        "attempted": {"type": "boolean"},
        "command": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "dry_run": {"type": "boolean"},
        "result": {"enum": ["succeeded", "failed", "not_attempted"]},
        "detail": {"type": "string"}
      }
    },
    "restoration": {
      "type": "object", "additionalProperties": false,
      "required": ["previous_packages", "config_backups"],
      "properties": {
        "previous_packages": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "previous_version", "architecture", "attempted", "result", "detail"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "previous_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "architecture": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "attempted": {"type": "boolean"},
              "result": {"enum": ["succeeded", "failed", "not_attempted"]},
              "detail": {"type": "string"}
            }
          }
        },
        "config_backups": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "attempted", "result", "detail"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "attempted": {"type": "boolean"},
              "result": {"enum": ["succeeded", "failed", "not_attempted"]},
              "detail": {"type": "string"}
            }
          }
        }
      }
    },
    "manual_intervention": {"type": "boolean"},
    "error": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {"code": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"}}
        }
      ]
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "not": {"pattern": "\\s"}
    },
    "host_name": {
      "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "not": {"pattern": "\\s"}
    }
  }
}
