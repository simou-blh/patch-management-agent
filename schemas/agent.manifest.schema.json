{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent integration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "version", "description", "filiere", "category",
               "developer", "team_name", "pricing_model", "price", "endpoints",
               "produces", "consumes"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1},
    "filiere": {"enum": ["cybersecurite", "automatisation_metier", "iot"]},
    "category": {"type": "string", "minLength": 1},
    "developer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"}
      }
    },
    "team_name": {"type": "string", "minLength": 1},
    "pricing_model": {"type": "string", "minLength": 1},
    "price": {"type": "number", "minimum": 0},
    "resource_requirements": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "cpu": {"type": "string"}, "memory_mb": {"type": "integer", "minimum": 1}
      }
    },
    "endpoints": {
      "type": "object", "additionalProperties": false,
      "required": ["base_url", "health", "activate", "deactivate", "status",
                   "config_schema", "exchange_notify"],
      "properties": {
        "base_url": {"type": "string", "pattern": "^https?://"},
        "health": {"type": "string", "pattern": "^/"},
        "activate": {"type": "string", "pattern": "^/"},
        "deactivate": {"type": "string", "pattern": "^/"},
        "status": {"type": "string", "pattern": "^/"},
        "config_schema": {"type": "string", "pattern": "^/"},
        "exchange_notify": {"type": "string", "pattern": "^/"}
      }
    },
    "produces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "consumes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
