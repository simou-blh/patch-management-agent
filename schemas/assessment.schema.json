{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patch assessment result v1",
  "description": "Per-package advisory assessment of one evidence record. Schema validity does not establish that evidence or advisories are fresh or that a patch is approved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessed_at", "evidence_collected_at", "advisory_fetched_at", "release", "results"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "assessed_at": {"$ref": "#/$defs/timestamp"},
    "evidence_collected_at": {"$ref": "#/$defs/timestamp"},
    "advisory_fetched_at": {"$ref": "#/$defs/timestamp"},
    "release": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "version": {"type": "string", "minLength": 1, "not": {"pattern": "\\s"}},
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "not": {"pattern": "\\s"}
    },
    "host_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]+:[a-z0-9][a-z0-9-]*$"},
    "priority": {"enum": ["critical", "high", "medium", "low"]},
    "source": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]+$"},
            "version": {"$ref": "#/$defs/version"}
          }
        }
      ]
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["advisory_id", "status", "fixed_version", "urgency", "reason"],
      "properties": {
        "advisory_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "status": {"enum": ["affected", "fixed", "uncertain"]},
        "fixed_version": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/version"}]},
        "urgency": {"enum": ["unimportant", "low", "medium", "high", "not yet assigned", "end-of-life"]},
        "reason": {"enum": ["installed_before_fix", "advisory_open", "installed_at_or_after_fix", "advisory_undetermined", "version_invalid"]}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "proposed_version", "priority", "reason"],
      "properties": {
        "action": {"enum": ["patch", "defer"]},
        "proposed_version": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/version"}]},
        "priority": {"$ref": "#/$defs/priority"},
        "reason": {"$ref": "#/$defs/text"}
      },
      "if": {"properties": {"action": {"const": "patch"}}},
      "then": {"properties": {"proposed_version": {"type": "string"}}},
      "else": {"properties": {"proposed_version": {"type": "null"}}}
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "package", "installed", "source", "status", "findings", "decision"],
      "properties": {
        "host": {"$ref": "#/$defs/host_name"},
        "package": {"$ref": "#/$defs/package_id"},
        "installed": {"type": "string", "minLength": 1, "not": {"pattern": "\\s"}},
        "source": {"$ref": "#/$defs/source"},
        "status": {"enum": ["affected", "fixed", "uncertain"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "decision": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decision"}]}
      }
    }
  }
}
