{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet sequential rollout result v1",
  "description": "Per-host sequential rollout outcome. Canary first; recovery only touches the failed host; later hosts are never reached after a failure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collected_at", "targets", "canary", "hosts", "summary", "error"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "collected_at": {"$ref": "#/$defs/timestamp"},
    "targets": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/host_name"}
    },
    "canary": {
      "anyOf": [
        {"$ref": "#/$defs/host_name"},
        {"type": "null"}
      ]
    },
    "hosts": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/host_name"},
      "additionalProperties": {"$ref": "#/$defs/host_rollout"}
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "completed", "failed", "stopped_early"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "stopped_early": {"type": "boolean"}
      }
    },
    "error": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {"code": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"}}
        }
      ]
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "not": {"pattern": "\\s"}
    },
    "host_name": {
      "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "not": {"pattern": "\\s"}
    },
    "step_status": {"enum": ["ready", "not_ready", "error", "completed", "skipped", "failed", "empty", "passed"]},
    "action": {"enum": ["proceed", "recover"]},
    "step_result": {
      "type": "object", "additionalProperties": false,
      "required": ["step", "status", "detail", "data"],
      "properties": {
        "step": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "status": {"$ref": "#/$defs/step_status"},
        "detail": {"$ref": "#/$defs/text"},
        "data": {"type": "object"}
      }
    },
    "host_rollout": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "collected_at", "preflight", "patch", "verify", "recover", "action", "blocking", "error"],
      "properties": {
        "target": {"$ref": "#/$defs/host_name"},
        "collected_at": {"$ref": "#/$defs/timestamp"},
        "preflight": {"$ref": "#/$defs/step_result"},
        "patch": {"$ref": "#/$defs/step_result"},
        "verify": {"$ref": "#/$defs/step_result"},
        "recover": {"type": "object"},
        "action": {"$ref": "#/$defs/action"},
        "blocking": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "error": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {"code": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"}}
            }
          ]
        }
      },
      "if": {"properties": {"action": {"const": "recover"}}},
      "then": {"properties": {"blocking": {"minItems": 1}}},
      "else": {"properties": {"blocking": {"maxItems": 0}}}
    }
  }
}
