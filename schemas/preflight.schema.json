{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet preflight readiness v1",
  "description": "Per-host readiness and recovery-preparation record. Schema validity does not establish that a host is ready to mutate; only status ready does.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collected_at", "targets", "hosts"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "collected_at": {"$ref": "#/$defs/timestamp"},
    "targets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/host_name"}
    },
    "hosts": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/host_name"},
      "additionalProperties": {"$ref": "#/$defs/host"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "not": {"pattern": "\\s"}
    },
    "host_name": {
      "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "not": {"pattern": "\\s"}
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "check_id": {
      "enum": ["privileges", "disk", "apt_locks", "apt_health", "drift", "candidates"]
    },
    "check_status": {"enum": ["pass", "fail", "error", "skipped"]},
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "detail", "data"],
      "properties": {
        "id": {"$ref": "#/$defs/check_id"},
        "status": {"$ref": "#/$defs/check_status"},
        "detail": {"$ref": "#/$defs/text"},
        "data": {"type": "object"}
      }
    },
    "backup_file": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "backup", "sha256", "size"],
      "properties": {
        "source": {"$ref": "#/$defs/text"},
        "backup": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "backup": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "detail", "files"],
      "properties": {
        "status": {"enum": ["verified", "not_attempted", "failed"]},
        "detail": {"$ref": "#/$defs/text"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/backup_file"}}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "size"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "recovery_artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "detail", "artifacts"],
      "properties": {
        "status": {"enum": ["verified", "not_attempted", "failed"]},
        "detail": {"$ref": "#/$defs/text"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "error": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {"code": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"}}
        }
      ]
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "collected_at", "checks", "backup",
        "recovery_artifacts", "blocking", "error"
      ],
      "properties": {
        "status": {"enum": ["ready", "not_ready", "error"]},
        "collected_at": {"$ref": "#/$defs/timestamp"},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "backup": {"$ref": "#/$defs/backup"},
        "recovery_artifacts": {"$ref": "#/$defs/recovery_artifacts"},
        "blocking": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "error": {"$ref": "#/$defs/error"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "error"}}},
          "then": {
            "properties": {
              "checks": {"maxItems": 0},
              "blocking": {"minItems": 1},
              "error": {"type": "object"}
            }
          },
          "else": {
            "properties": {"error": {"type": "null"}},
            "allOf": [
              {
                "if": {"properties": {"status": {"const": "ready"}}},
                "then": {"properties": {"blocking": {"maxItems": 0}}},
                "else": {"properties": {"blocking": {"minItems": 1}}}
              }
            ]
          }
        }
      ]
    }
  }
}
