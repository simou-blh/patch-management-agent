{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "patch",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "fleet_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "approval_*",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
