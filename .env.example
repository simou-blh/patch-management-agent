# Copy to .env. Docker Compose reads this file; never commit the filled copy.
SEMAPHORE_ADMIN_PASSWORD=
# Generate: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SEMAPHORE_ACCESS_KEY_ENCRYPTION=
# Create in Semaphore UI after its first startup; needed only by the upstream profile.
SEMAPHORE_API_TOKEN=
# No model provider is selected by this repo. Connect ONE provider in OpenCode /connect.
# Operator evidence lifetime: choose a positive integer number of seconds with the team.
# Python CLIs/MCP do not load .env; export this in their shell/process environment.
PATCH_AGENT_EVIDENCE_MAX_AGE_SECONDS=
